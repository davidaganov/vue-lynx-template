{
  "name": "i18n",
  "requires": ["tests", "demo-pages"],
  "copy": [
    "src/i18n",
    "src/composables/useI18n.ts",
    "src/plugins/i18n.ts",
    "src/types/enums/locales.enum.ts",
    "src/types/locales.interface.ts",
    "src/components/ui/UiLanguageSwitcher.vue",
    "src/__tests__/plugins/i18n.test.ts",
    "src/__tests__/plugins/plugin.test.ts",
    "src/__tests__/components/ui/UiLanguageSwitcher.test.ts",
    "src/__tests__/composables/useI18n.test.ts"
  ],
  "patches": [
    {
      "file": "src/types/enums/index.ts",
      "action": "insert-before-marker",
      "marker": "// @webstack:locale-enums",
      "lines": ["export * from \"./locales.enum\""]
    },
    {
      "file": "src/types/index.ts",
      "action": "insert-before-marker",
      "marker": "// @webstack:locale-types",
      "lines": ["export * from \"./locales.interface\""]
    },
    {
      "file": "src/index.ts",
      "action": "insert-before-marker",
      "marker": "// @webstack:import",
      "lines": [
        "import { createI18n } from \"@/i18n\"",
        "import { LOCALES } from \"@/types\""
      ]
    },
    {
      "file": "src/index.ts",
      "action": "insert-before-marker",
      "marker": "// @webstack:use",
      "lines": [
        "const i18n = createI18n({ defaultLocale: LOCALES.EN })",
        "app.use(i18n)"
      ]
    },
    {
      "file": "src/layouts/default.vue",
      "action": "insert-before-marker",
      "marker": "// @webstack:layout-imports",
      "lines": ["import UiLanguageSwitcher from \"@/components/ui/UiLanguageSwitcher.vue\""]
    },
    {
      "file": "src/layouts/default.vue",
      "action": "insert-before-marker",
      "marker": "<!-- @webstack:layout-top-bar -->",
      "lines": ["<UiLanguageSwitcher />"]
    },
    {
      "file": "src/components/pages/about/AboutPage.vue",
      "action": "replace-marker",
      "marker": "<!-- @webstack:about-title -->\n        About",
      "lines": ["{{ $t(\"about.title\") }}"]
    },
    {
      "file": "src/components/pages/about/AboutPage.vue",
      "action": "replace-marker",
      "marker": "<!-- @webstack:about-description -->\n      This template is a starting point for your Vue Lynx project.",
      "lines": ["{{ $t(\"about.description\") }}"]
    },
    {
      "file": "src/components/pages/about/AboutPage.vue",
      "action": "replace-marker",
      "marker": "<!-- @webstack:about-return-button -->\n      ← Return",
      "lines": ["{{ $t(\"about.returnButton\") }}"]
    },
    {
      "file": "src/components/pages/about/AboutInfo.vue",
      "action": "insert-before-marker",
      "marker": "// @webstack:about-info-setup",
      "lines": ["import { useI18n } from \"@/i18n\"", "", "const { t } = useI18n()"]
    },
    {
      "file": "src/components/pages/about/AboutInfo.vue",
      "action": "replace-marker",
      "marker": "/* @webstack:about-feat-i18n */ \"i18n Support\"",
      "lines": ["t(\"about.features.i18n\")"]
    },
    {
      "file": "src/components/pages/about/AboutInfo.vue",
      "action": "replace-marker",
      "marker": "/* @webstack:about-feat-pinia */ \"Pinia Support\"",
      "lines": ["t(\"about.features.pinia\")"]
    },
    {
      "file": "src/components/pages/about/AboutInfo.vue",
      "action": "replace-marker",
      "marker": "/* @webstack:about-feat-tailwind */ \"Tailwind Support\"",
      "lines": ["t(\"about.features.tailwind\")"]
    },
    {
      "file": "src/components/pages/about/AboutInfo.vue",
      "action": "replace-marker",
      "marker": "/* @webstack:about-feat-tests */ \"Unit Tests (Vitest)\"",
      "lines": ["t(\"about.features.tests\")"]
    },
    {
      "file": "src/components/pages/home/HomeHero.vue",
      "action": "replace-marker",
      "marker": "<!-- @webstack:hero-title -->\n        Lynx",
      "lines": ["{{ $t(\"home.hero.title\") }}"]
    },
    {
      "file": "src/components/pages/home/HomeHero.vue",
      "action": "replace-marker",
      "marker": "<!-- @webstack:hero-subtitle -->\n        Starter Template",
      "lines": ["{{ $t(\"home.hero.subtitle\") }}"]
    },
    {
      "file": "src/components/pages/home/HomeHero.vue",
      "action": "replace-marker",
      "marker": "<!-- @webstack:hero-description -->\n      A simple template for quickly building mobile applications with Vue Lynx.",
      "lines": ["{{ $t(\"home.hero.description\") }}"]
    },
    {
      "file": "src/components/pages/home/HomeHero.vue",
      "action": "replace-marker",
      "marker": "<!-- @webstack:hero-badge -->\n        {{ appStore.version }}",
      "lines": ["{{ $t(\"home.badge\", { version: appStore.version }) }}"],
      "optional": true
    },
    {
      "file": "src/components/pages/home/HomeHero.vue",
      "action": "replace-marker",
      "marker": "<!-- @webstack:hero-badge -->\n        v1.0.0",
      "lines": ["{{ $t(\"home.badge\", { version: \"1.0.0\" }) }}"],
      "optional": true
    },
    {
      "file": "src/components/pages/home/HomeActions.vue",
      "action": "replace-marker",
      "marker": "<!-- @webstack:home-actions-get-started -->\n      Get Started",
      "lines": ["{{ $t(\"home.actions.getStarted\") }}"]
    },
    {
      "file": "src/components/pages/home/HomeActions.vue",
      "action": "replace-marker",
      "marker": "<!-- @webstack:home-actions-read-more -->\n      Read More",
      "lines": ["{{ $t(\"home.actions.readMore\") }}"]
    },
    {
      "file": "src/__tests__/utils.ts",
      "action": "insert-before-marker",
      "marker": "// @webstack:test-utils-imports",
      "lines": ["import { createI18n } from \"@/i18n\"", "import { LOCALES } from \"@/types\""]
    },
    {
      "file": "src/__tests__/utils.ts",
      "action": "insert-before-marker",
      "marker": "// @webstack:test-utils-plugins",
      "lines": ["createI18n({ defaultLocale: LOCALES.EN }),"]
    }
  ],
  "packageJson": {
    "scripts": {
      "translate": "polyglot-keeper sync"
    },
    "devDependencies": ["polyglot-keeper"]
  }
}
