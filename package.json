{
  "name": "lynx-starter",
  "version": "1.0.1",
  "description": "A simple template for quickly building mobile applications with Vue Lynx.",
  "type": "module",
  "keywords": [
    "vue-lynx",
    "template",
    "mobile",
    "android",
    "web",
    "cross-platform",
    "vue"
  ],
  "homepage": "https://aganov.dev/en/docs/guides/starters/vue-lynx-template",
  "bugs": {
    "url": "https://github.com/davidaganov/lynx-starter/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/davidaganov/lynx-starter"
  },
  "author": {
    "name": "David Aganov",
    "url": "https://aganov.dev"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "sync": "npx lynx-native-cli sync",
    "android": "npx lynx-native-cli build android",
    "android:icons": "node scripts/generate-android-icons.mjs",
    "build": "rspeedy build",
    "build:android": "node scripts/build-android.mjs",
    "dev": "rspeedy dev",
    "preview": "rspeedy preview",
    "typecheck": "vue-tsc --noEmit",
    "translate": "polyglot-keeper sync",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "pinia": "^3.0.4",
    "vue": "^3.5.0",
    "vue-lynx": "^0.3.1",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lynx-js/qrcode-rsbuild-plugin": "^0.4.6",
    "@lynx-js/rspeedy": "^0.13.5",
    "@lynx-js/template-webpack-plugin": "^0.11.0",
    "@lynx-js/types": "^3.7.0",
    "@rsbuild/plugin-vue": "^1.2.6",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^4.1.5",
    "@vue/test-utils": "^2.4.9",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^10.9.0",
    "globals": "^17.5.0",
    "jsdom": "^29.1.0",
    "polyglot-keeper": "^1.3.1",
    "prettier": "^3.8.3",
    "sharp": "^0.33.5",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.5",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.7"
  }
}
